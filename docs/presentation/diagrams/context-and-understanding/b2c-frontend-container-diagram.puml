@startuml
!include plantuml/vendor/c4-plantuml/C4_Container.puml
!include plantuml/sodexo-theme.puml
!include plantuml/sodexo-c4-theme.puml

title Sodexo B2C Frontend Application — Container View
footer (c) Developed by <b>Mohit Kanwar</b>
caption C4 Level 2 · Blue = existing · Red = new accommodation capability · Amber = decision required

!pragma layout smetana
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45
LAYOUT_LANDSCAPE()

AddElementTag("existing", $bgColor=SODEXO_BLUE_PALE, $fontColor=SODEXO_INK, $borderColor=SODEXO_BLUE, $shadowing="false", $legendText="Existing capability")
AddElementTag("new", $bgColor=SODEXO_RED_LIGHT, $fontColor=SODEXO_INK, $borderColor=SODEXO_RED, $shadowing="false", $legendText="New accommodation capability")
AddElementTag("decision", $bgColor=SODEXO_WARNING_LIGHT, $fontColor=SODEXO_INK, $borderColor=SODEXO_WARNING, $shadowing="false", $legendText="Architecture decision required")

Person(employee, "Employee Traveller", "Uses the Sodexo B2C application to request accommodation")
Person_Ext(bookingTeam, "Client Booking Team", "Receives and processes employee booking requests")

System_Boundary(b2cFrontend, "Sodexo B2C Frontend Application") {
  Container(hostShell, "B2C Host Shell", "React SPA · Existing", "Provides authentication and authorization integration, session management, push notification handling, alerts management, navigation and Lego composition", $tags="existing")
  Container(accommodationLego, "Accommodation Booking Lego", "React Micro Frontend · New", "Lists client countries and sites; captures destination, dates and stay needs; displays sortable, filterable and map-based proposals; confirms selection and submits a booking request", $tags="new")
}

System_Ext(existingPlatform, "Existing B2C Platform Services", "Identity and access, session lifecycle, push notifications and alerts APIs", $tags="existing")
System_Ext(accommodationBff, "Accommodation Booking BFF", "New server-side APIs for destinations, policy-aware search, proposals and booking requests", $tags="new")
System_Ext(mapPlatform, "Map Platform", "Map tiles and rendering integration; provider and access model to be confirmed", $tags="decision")

Rel(employee, hostShell, "Uses", "HTTPS")
Rel(hostShell, existingPlatform, "Authenticates users, maintains sessions and exchanges push and alert data", "OIDC / OAuth 2.0 / HTTPS")
Rel(hostShell, accommodationLego, "Loads and supplies authenticated user context", "Module federation / runtime contract")
Rel(accommodationLego, accommodationBff, "Loads destinations, searches proposals and submits booking requests", "HTTPS / JSON")
Rel(accommodationLego, mapPlatform, "Displays proposals on a map", "Map SDK / HTTPS")
Rel(accommodationBff, bookingTeam, "Routes the confirmed request for review and booking", "Workflow / notification")

Lay_R(employee, hostShell)
Lay_R(hostShell, accommodationLego)
Lay_R(accommodationLego, accommodationBff)
Lay_D(hostShell, existingPlatform)
Lay_D(accommodationLego, mapPlatform)
Lay_D(accommodationBff, bookingTeam)

@enduml
