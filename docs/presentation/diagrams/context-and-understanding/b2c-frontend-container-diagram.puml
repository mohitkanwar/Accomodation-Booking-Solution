@startuml
!include plantuml/vendor/c4-plantuml/C4_Container.puml
!include plantuml/sodexo-theme.puml
!include plantuml/sodexo-c4-theme.puml

title Sodexo B2C Frontend Application — UI Capability View
footer (c) Developed by <b>Mohit Kanwar</b>
caption UI capability view · Blue = existing experience · Red = proposed accommodation experience · Amber = decision required

!pragma layout smetana
skinparam linetype polyline
skinparam nodesep 18
skinparam ranksep 28

AddElementTag("existing", $bgColor=SODEXO_BLUE_PALE, $fontColor=SODEXO_INK, $borderColor=SODEXO_BLUE, $shadowing="false", $legendText="Existing capability")
AddElementTag("new", $bgColor=SODEXO_RED_LIGHT, $fontColor=SODEXO_INK, $borderColor=SODEXO_RED, $shadowing="false", $legendText="New accommodation capability")
AddElementTag("decision", $bgColor=SODEXO_WARNING_LIGHT, $fontColor=SODEXO_INK, $borderColor=SODEXO_WARNING, $shadowing="false", $legendText="Architecture decision required")
AddBoundaryTag("existingGroup", $bgColor=SODEXO_BLUE_PALE, $fontColor=SODEXO_BLUE_DARK, $borderColor=SODEXO_BLUE, $shadowing="false", $borderStyle="dashed", $legendText="Existing functional area")
AddBoundaryTag("newGroup", $bgColor=SODEXO_RED_LIGHT, $fontColor=SODEXO_INK, $borderColor=SODEXO_RED, $shadowing="false", $borderStyle="dashed", $legendText="Proposed functional area")

Person(employee, "Employee Traveller", "Uses the Sodexo B2C application to request accommodation")
Person_Ext(bookingTeam, "Client Booking Team", "Receives and processes employee booking requests")

System_Boundary(b2cFrontend, "Sodexo B2C Frontend Application") {
  Container_Boundary(hostShell, "B2C Host Shell · React SPA") {
    Boundary(existingFunctions, "EXISTING SHARED FUNCTIONALITY", $tags="existingGroup") {
      Container(auth, "Authentication &\nRole-aware Access", "Existing B2C UX", "Single sign-on and access based on the employee's assigned role", $tags="existing")
      Container(session, "Session\nContinuity", "Existing B2C UX", "Keeps the employee's authenticated journey active and secure", $tags="existing")
      Container(push, "Push\nNotifications", "Existing B2C UX", "Delivers timely booking status updates to the employee", $tags="existing")
      Container(alerts, "In-app Alerts\n& Actions", "Existing B2C UX", "Surfaces status messages and actions that need attention", $tags="existing")
      Container(composition, "Navigation &\nAccommodation Entry", "Existing B2C UX", "Provides the B2C navigation entry and loads the accommodation Lego", $tags="existing")
    }

    Boundary(proposedFunctions, "PROPOSED EMPLOYEE ACCOMMODATION EXPERIENCE · REACT MICRO FRONTEND", $tags="newGroup") {
      Container(destinations, "Destination &\nSite Picker", "Proposed UI/UX", "Choose from countries and Sodexo sites available to the employee", $tags="new")
      Container(searchForm, "Stay Search", "Proposed UI/UX", "Enter dates, guests and accommodation preferences in a guided form", $tags="new")
      Container(proposals, "Results &\nSmart Filters", "Proposed UI/UX", "Compare policy-eligible stays using clear sorting and filters", $tags="new")
      Container(mapView, "Map\nExploration", "Proposed UI/UX", "Explore available stays geographically without losing search context", $tags="new")
      Container(request, "Review &\nSubmit Request", "Proposed UI/UX", "Review the selected stay, confirm details and submit the request", $tags="new")
    }
  }
}

System_Ext(existingPlatform, "Existing B2C Platform Services", "Identity and access, session lifecycle, push notifications and alerts APIs", $tags="existing")
System_Ext(accommodationBff, "Accommodation Booking BFF", "New server-side APIs for destinations, policy-aware search, proposals and booking requests", $tags="new")
System_Ext(mapPlatform, "Map Platform", "Map tiles and rendering integration; provider and access model to be confirmed", $tags="decision")

Rel_D(employee, hostShell, "Uses", "HTTPS")
Rel_D(existingFunctions, existingPlatform, "")
Rel_D(proposedFunctions, accommodationBff, "")
Rel_D(proposedFunctions, mapPlatform, "")
Rel_R(accommodationBff, bookingTeam, "")

Lay_R(auth, session)
Lay_R(session, push)
Lay_R(push, alerts)
Lay_R(alerts, composition)

Lay_R(destinations, searchForm)
Lay_R(searchForm, proposals)
Lay_R(proposals, mapView)
Lay_R(mapView, request)

Lay_D(employee, hostShell)
Lay_D(existingFunctions, proposedFunctions)
Lay_D(hostShell, existingPlatform)
Lay_R(existingPlatform, accommodationBff)
Lay_R(accommodationBff, mapPlatform)
Lay_R(accommodationBff, bookingTeam)

@enduml
