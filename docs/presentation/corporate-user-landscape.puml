@startuml
!include ../../plantuml/sodexo-theme.puml

title Accommodation Ecosystem — Corporations and Users
caption Each corporation has its own users · Seeker and provider corporations scale from 1 to N

top to bottom direction
hide stereotype
skinparam linetype polyline
skinparam nodesep 55
skinparam ranksep 70
skinparam rectangle {
  RoundCorner 16
}

skinparam rectangleBackgroundColor<<sodexo>> SODEXO_BLUE
skinparam rectangleBorderColor<<sodexo>> SODEXO_BLUE_DARK
skinparam rectangleFontColor<<sodexo>> SODEXO_WHITE

rectangle "Accommodation Seeker Corps\n<size:12>1..N client organisations</size>" as Seekers SODEXO_BLUE_PALE {
  rectangle "<b>Seeker Corp A</b>\n\n<size:11>USERS</size>\n• Travellers\n• Approvers\n• Corporate Administrators" as SeekerA SODEXO_WHITE
  rectangle "⋯\n<size:11>MORE SEEKER CORPS</size>" as MoreSeekers SODEXO_BLUE_LIGHT
  rectangle "<b>Seeker Corp N</b>\n\n<size:11>USERS</size>\n• Travellers\n• Approvers\n• Corporate Administrators" as SeekerN SODEXO_WHITE

  SeekerA -[hidden]right-> MoreSeekers
  MoreSeekers -[hidden]right-> SeekerN
}

rectangle "<b>Sodexo</b>\n\n<size:11>USERS</size>\n• Booking Operators\n• Sodexo Administrators\n\n<size:11>CAPABILITY</size>\nAccommodation Booking Platform" as Sodexo <<sodexo>>

rectangle "Accommodation Provider Corps\n<size:12>1..N supplier organisations</size>" as Providers SODEXO_RED_LIGHT {
  rectangle "<b>Provider Corp A</b>\n\n<size:11>USERS</size>\n• Reservation Agents\n• Property Administrators" as ProviderA SODEXO_WHITE
  rectangle "⋯\n<size:11>MORE PROVIDER CORPS</size>" as MoreProviders SODEXO_RED_LIGHT
  rectangle "<b>Provider Corp N</b>\n\n<size:11>USERS</size>\n• Reservation Agents\n• Property Administrators" as ProviderN SODEXO_WHITE

  ProviderA -[hidden]right-> MoreProviders
  MoreProviders -[hidden]right-> ProviderN
}

Seekers -down-> Sodexo : users search and request accommodation
Sodexo -down-> Providers : searches inventory and creates reservations
@enduml
